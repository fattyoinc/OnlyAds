# ---- App (EXPO_PUBLIC_* values are PUBLIC: inlined into the app bundle. Never put secrets here.) ----
# development | staging | production  (production strips the demo catalog from the bundle)
EXPO_PUBLIC_APP_ENV=development
# Only Ads API. Use your computer's LAN IP when testing on a phone. Must be https outside local dev.
EXPO_PUBLIC_OFFERS_API_URL=http://localhost:8787
EXPO_PUBLIC_SUPPORT_EMAIL=

# ---- API server (see docs/OPERATIONS.md for all options) ----
# APP_ENV=development
# DB_PATH=server/onlyads.dev.db
# CORS_ORIGINS=http://localhost:8081
