{
  "name": "only-ads",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.3.2",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.21",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.13",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "server": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --tsconfig tsconfig.json server/index.ts",
    "lint": "expo lint",
    "check": "npm run test:all",
    "admin": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --tsconfig tsconfig.json server/cli.ts",
    "test:server": "NODE_ENV=test node --disable-warning=ExperimentalWarning --import tsx --test server/__tests__/*.test.ts",
    "release:check": "node scripts/release-check.js",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run test:server && npm run check:secrets",
    "legal:export": "tsx --tsconfig tsconfig.json scripts/export-legal.ts",
    "check:secrets": "node scripts/check-secrets.js"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "setupFiles": [
      "<rootDir>/test/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/server/"
    ]
  }
}
